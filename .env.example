# ADMIN_2_ID = আরেকজন এডমিন — গ্রুপ/চ্যানেল add-remove-allow-block ছাড়া বাকি সব কমান্ড
# একাধিক আইডি লাগলে কমা দিয়ে লিখুন: 111,222
ADMIN_1_ID=
ADMIN_2_ID=

# ═════════ 💎 API 1..4 (ক্রমান্বয়ে চেষ্টা হয়) ═════════
API_1_URL=
API_1_KEY=
API_2_URL=
API_2_KEY=
API_3_URL=
API_3_KEY=
API_4_URL=
API_4_KEY=

# ঐচ্ছিক: 1 = কোনো API-র লিমিট শেষ হলে পরের API-তে যাবে (ডিফল্ট), 0 = প্রথম লিমিটেই থামবে
QUOTA_FALLBACK=1

# ═════════ ⚡ আলাদা MAX Like API ═════════
